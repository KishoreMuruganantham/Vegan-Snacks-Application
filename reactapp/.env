# ---------------------------------------------------------------------------
# Vegan Snacks Application - React.js client
# ---------------------------------------------------------------------------
# Port the Create React App development server binds to.
# The problem statement requires the React app to run on port 8081 while the
# Spring Boot API runs on port 8080.
PORT=8081

# Bind on every network interface so the dev server is reachable from a
# container / remote browser (the Hexaware grader proxies port 8081).
HOST=0.0.0.0

# Do not try to launch a system browser (headless CI / containers).
BROWSER=none

# Faster rebuilds.
GENERATE_SOURCEMAP=false
FAST_REFRESH=true
